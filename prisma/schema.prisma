generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  plan          Plan      @default(FREE)
  planExpiresAt DateTime?
  schoolName    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  moduls   Modul[]

  @@map("users")
}

model Modul {
  id        String      @id @default(cuid())
  userId    String
  judul     String
  mapel     String
  jenjang   String
  kelas     String
  fase      String
  topik     String
  tujuan    String
  model     String
  pertemuan Int
  menit     Int
  cp        String?
  content   String?     @db.Text
  status    ModulStatus @default(PROCESSING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  design ModulDesign?

  @@map("moduls")
}

model ModulDesign {
  id        String   @id @default(cuid())
  modulId   String   @unique
  template  String   @default("formal")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modul Modul @relation(fields: [modulId], references: [id], onDelete: Cascade)

  @@map("modul_designs")
}

model Subject {
  id      String  @id @default(cuid())
  name    String  @unique
  order   Int     @default(0)
  active  Boolean @default(true)

  @@map("subjects")
}

model Template {
  id       String @id @default(cuid())
  mapel    String
  jenjang  String
  kelas    String
  judul    String
  content  String @db.Text
  useCount Int    @default(0)

  @@map("templates")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Plan {
  FREE
  PRO
  SCHOOL
}

enum ModulStatus {
  PROCESSING
  DRAFT
  DONE
}

model LearningOutcome {
  id        String   @id @default(cuid())
  subject   String
  phase     String
  level     String
  elements  LearningOutcomeElement[]
  chapters  Chapter[]
  createdAt DateTime @default(now())

  @@unique([subject, phase])
  @@map("learning_outcomes")
}

model LearningOutcomeElement {
  id               String          @id @default(cuid())
  learningOutcomeId String
  name             String
  description      String          @db.Text
  learningOutcome  LearningOutcome @relation(fields: [learningOutcomeId], references: [id], onDelete: Cascade)

  @@map("learning_outcome_elements")
}

model Chapter {
  id               String          @id @default(cuid())
  learningOutcomeId String
  number           Int
  name             String
  grade            String
  semester         Int
  objectives       LearningObjective[]
  learningOutcome  LearningOutcome @relation(fields: [learningOutcomeId], references: [id], onDelete: Cascade)

  @@map("chapters")
}

model LearningObjective {
  id                  String         @id @default(cuid())
  chapterId           String
  code                String         @unique
  title               String         @db.Text
  shortTitle          String
  soloLevel           SoloLevel
  allocationHours     Int
  learningFlow        LearningFlow[]
  formativeAssessment String         @db.Text
  summativeAssessment String         @db.Text
  profileDimensions   String[]
  cpElements          String[]
  chapter             Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("learning_objectives")
}

model LearningFlow {
  id                  String            @id @default(cuid())
  learningObjectiveId String
  sequence            Int
  phase               String
  description         String            @db.Text
  learningObjective   LearningObjective @relation(fields: [learningObjectiveId], references: [id], onDelete: Cascade)

  @@map("learning_flows")
}

enum SoloLevel {
  MULTISTRUCTURAL
  RELATIONAL
  EXTENDED_ABSTRACT
}
